[Unit]
Description=Xandeum Pod Manager (Pod-Man) Web Dashboard
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/root/pod-man
ExecStart=/usr/bin/node /root/pod-man/server.js
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal
SyslogIdentifier=pod-manager

# Security hardening
NoNewPrivileges=false
PrivateTmp=true

# Environment
Environment=NODE_ENV=production

[Install]
WantedBy=multi-user.target
